# Copy this file to .env.local and fill in your keys.
# These are SERVER-ONLY. Never prefix them with NEXT_PUBLIC_.

# AI provider: "groq" (default) or "gemini"
AI_PROVIDER=groq

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# If your account can't use this model, the app falls back to llama-3.1-8b-instant / gpt-oss automatically
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (optional, only if AI_PROVIDER=gemini): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub fine-grained token, public repos read-only: https://github.com/settings/tokens
# Optional but recommended: raises the GitHub limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Max characters of code sent to the model per request (keep low on Groq's free tier)
MAX_CONTEXT_CHARS=16000

# Max AI requests per visitor (IP) per minute, protects your Groq quota once deployed
AI_REQUESTS_PER_MINUTE=20
